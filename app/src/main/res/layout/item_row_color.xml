<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/padding_xs"
    android:paddingVertical="@dimen/padding_xs">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Color"
        android:textColor="#000000"
        android:textSize="@dimen/text_md" />

    <LinearLayout
        android:id="@+id/chooseColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/userSelectedColor"
            android:layout_width="35dp"
            android:layout_height="20dp"
            android:background="@drawable/bg_rounded_main" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="@dimen/padding_xs"
            android:src="@drawable/ic_arrow_right" />

    </LinearLayout>

</LinearLayout>
