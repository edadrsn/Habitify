<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/Mon"
        style="@style/DayChip"
        android:text="Mon" />

    <TextView
        android:id="@+id/Tue"
        style="@style/DayChip"
        android:text="Tue" />

    <TextView
        android:id="@+id/Wed"
        style="@style/DayChip"
        android:text="Wed" />

    <TextView
        android:id="@+id/Thu"
        style="@style/DayChip"
        android:text="Thu" />

    <TextView
        android:id="@+id/Fri"
        style="@style/DayChip"
        android:text="Fri" />

    <TextView
        android:id="@+id/Sat"
        style="@style/DayChip"
        android:text="Sat" />

    <TextView
        android:id="@+id/Sun"
        style="@style/DayChip"
        android:text="Sun" />

</LinearLayout>