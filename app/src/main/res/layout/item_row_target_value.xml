<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/padding_xs"
    android:paddingVertical="@dimen/padding_xs">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Target Value"
        android:textColor="#000000"
        android:textSize="@dimen/text_medium" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/padding_xs"
        android:weightSum="1">

        <EditText
            android:id="@+id/targetValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_bg_target_value"
            android:hint="100"
            android:inputType="number"
            android:maxLines="2"
            android:paddingHorizontal="@dimen/padding_small"
            android:paddingVertical="@dimen/padding_xs"
            android:text=""
            android:textColor="#000000"
            android:textColorHint="#999999"
            android:textSize="@dimen/text_normal" />

        <TextView
            android:id="@+id/targetType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/padding_small"
            android:text="/Category"
            android:textColor="#000000"
            android:textSize="@dimen/text_normal" />

    </LinearLayout>

</LinearLayout>
